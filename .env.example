# Copie para .env.local e preencha. Nunca commite o .env.local.
# Supabase (Project Settings > API Keys). A "publishable key" (sb_publishable_...) é pública por design e pode ir ao navegador.
# A "secret key" (sb_secret_...) NUNCA vai para o navegador nem para este repositório.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
